---
import { settings } from '@/lib/content';
import { withBase } from '@/lib/paths';

type Props = {
  variant: 'service' | 'parts' | 'stationary';
  requestHref?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  enablePhoto?: boolean;
};

const {
  variant,
  requestHref = '#request',
  secondaryHref = variant === 'stationary' ? withBase('/') : '#request',
  secondaryLabel = variant === 'stationary' ? 'Сервис' : 'Фото',
  enablePhoto = variant === 'service' && requestHref === '#request'
} = Astro.props;
const contacts = await settings<any>('contacts');
---
<div class="mobile-cta">
  <a class="mobile-side" href={contacts.phoneHref}>Позвонить</a>
  {variant === 'parts' ? (
    <>
      <a class="mobile-main" href="#request" data-mode="part">Подобрать</a>
      <a class="mobile-side" href="#request" data-mode="install">+ установка</a>
    </>
  ) : (
    <>
      <a class="mobile-main" href={requestHref}>{variant === 'stationary' ? 'Записаться на диагностику' : 'Вызвать сервис'}</a>
      <a class="mobile-side" href={secondaryHref} data-photo={enablePhoto ? true : undefined}>{secondaryLabel}</a>
    </>
  )}
</div>
