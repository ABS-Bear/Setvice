---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Scripts from '@/components/Scripts.astro';
import { canonicalUrl, withBase } from '@/lib/paths';
import { settings } from '@/lib/content';

type Props = {
  activePath: string;
  pageKey: 'home' | 'parts' | 'stationary' | 'articles';
  secondaryNav?: { label: string; href: string }[];
  ctaText?: string;
  ctaHref?: string;
  pageScript?: string;
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImagePath?: string;
  noindex?: boolean;
};

const {
  activePath,
  pageKey,
  secondaryNav = [],
  ctaText,
  ctaHref = '#request',
  pageScript,
  title,
  description,
  canonicalPath,
  ogType = 'website',
  ogImagePath,
  noindex = false
} = Astro.props;
const contacts = await settings<any>('contacts');
const seo = await settings<any>('seo');
const pageSeo = seo.pages[pageKey];
const pageTitle = title || pageSeo.title;
const pageDescription = description || pageSeo.description;
const canonical = canonicalUrl(contacts.siteUrl, canonicalPath || pageSeo.canonical);
const ogImage = ogImagePath
  ? canonicalUrl(contacts.siteUrl, ogImagePath)
  : pageKey === 'stationary'
    ? ''
    : canonicalUrl(contacts.siteUrl, seo.defaultImage);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0E1B2F" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="abservice-build" content="gate3a-telegram-production-readiness-2026-09-03" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href={withBase('/site.css')} />
    <link rel="stylesheet" href={withBase('/parts-promo.css')} />
    <link rel="stylesheet" href={withBase('/parts.css')} />
    <link rel="stylesheet" href={withBase('/refinement.css')} />
  </head>
  <body>
    <Header activePath={activePath} secondaryNav={secondaryNav} ctaText={ctaText} ctaHref={ctaHref} />
    <slot />
    <Footer activePath={activePath} />
    <Scripts pageScript={pageScript} />
  </body>
</html>
