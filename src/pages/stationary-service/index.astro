---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Contacts from '@/components/Contacts.astro';
import MobileCta from '@/components/MobileCta.astro';
import { settings } from '@/lib/content';
import { withBase } from '@/lib/paths';

const page = await settings<any>('stationary-page');
---
<BaseLayout
  activePath="/stationary-service/"
  pageKey="stationary"
  secondaryNav={[
    { label: 'О направлении', href: '#about' },
    { label: 'Запись', href: '#request' }
  ]}
  ctaText="Записаться на диагностику"
  pageScript="site.js"
>
  <main>
    <Hero {...page.hero} variant="stationary" showPhoto={false} secondaryHref="/" />
    <section class="parts-how" id="about">
      <div class="container">
        <div class="eyebrow">{page.content.eyebrow}</div>
        <h2 class="section-title">{page.content.title}</h2>
        <p class="section-lead">{page.content.lead}</p>
        <div class="stationary-points">
          {(page.content.items as any[]).map((item: any) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
        <p class="section-lead stationary-parts-link">
          <a class="parts-inline-link" href={withBase('/parts/')}>{page.content.partsLinkLabel || 'Смотреть раздел запчастей'} →</a>
        </p>
      </div>
    </section>
    <Contacts variant="stationary" />
  </main>
  <MobileCta variant="stationary" />
</BaseLayout>
