---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Contacts from '@/components/Contacts.astro';
import MobileCta from '@/components/MobileCta.astro';
import { settings } from '@/lib/content';

const page = await settings<any>('stationary-page');
---
<BaseLayout
  activePath="/stationary-service/"
  pageKey="stationary"
  secondaryNav={[
    { label: 'Что известно', href: '#known' },
    { label: 'Контакты', href: '#request' }
  ]}
  ctaText="Обсудить задачу"
  pageScript="site.js"
>
  <main>
    <Hero {...page.hero} secondaryHref="/" />
    <section class="parts-how" id="known">
      <div class="container">
        <div class="eyebrow">{page.content.eyebrow}</div>
        <h2 class="section-title">{page.content.title}</h2>
        <p class="section-lead">{page.content.lead}</p>
        <div class="parts-steps">
          {(page.content.items as any[]).map((item: any, index: number) => (
            <article><b>{String(index + 1).padStart(2, '0')}</b><h3>{item.title}</h3><p>{item.text}</p></article>
          ))}
        </div>
      </div>
    </section>
    <Contacts variant="stationary" />
  </main>
  <MobileCta variant="stationary" />
</BaseLayout>
