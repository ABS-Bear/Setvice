---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MobileCta from '@/components/MobileCta.astro';
import { getCollection } from 'astro:content';
import { settings } from '@/lib/content';
import { withBase } from '@/lib/paths';

const page = await settings<any>('articles-page');
const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => (b.data.publishDate?.getTime() || 0) - (a.data.publishDate?.getTime() || 0));
---
<BaseLayout
  activePath="/articles/"
  pageKey="articles"
  secondaryNav={[
    { label: 'Сервис', href: '/' },
    { label: 'Запчасти', href: '/parts/' }
  ]}
  ctaText="Вызвать сервис"
  ctaHref="/#request"
  noindex={articles.length === 0}
>
  <main>
    <section class="intro">
      <div class="container intro-grid">
        <div>
          <div class="eyebrow">{page.eyebrow}</div>
          <h1 class="section-title">{page.title}</h1>
        </div>
        <div>
          <p class="intro-copy">{page.lead}</p>
        </div>
      </div>
    </section>
    <section class="parts-groups">
      <div class="container">
        {articles.length > 0 ? (
          <div class="parts-groups-grid">
            {articles.map((article) => (
              <a class="parts-groups-grid-link" href={withBase(`/articles/${article.slug}/`)}>
                <strong>{article.data.title}</strong>
                <span>{article.data.publishDate ? article.data.publishDate.toLocaleDateString('ru-RU') : 'Материал'}</span>
              </a>
            ))}
          </div>
        ) : (
          <div class="parts-groups-grid">
            <div class="parts-groups-grid-link" aria-live="polite">
              <strong>{page.emptyTitle}</strong>
              <span>{page.emptyText}</span>
            </div>
          </div>
        )}
      </div>
    </section>
  </main>
  <MobileCta variant="service" requestHref={withBase('/#request')} secondaryHref={withBase('/parts/')} secondaryLabel="Запчасти" enablePhoto={false} />
</BaseLayout>
