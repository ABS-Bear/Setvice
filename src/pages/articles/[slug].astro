---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MobileCta from '@/components/MobileCta.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/paths';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const title = article.data.seoTitle || `${article.data.title} — ABService`;
const description = article.data.seoDescription || article.data.description;
const canonicalPath = `/articles/${article.slug}/`;
---
<BaseLayout
  activePath="/articles/"
  pageKey="articles"
  secondaryNav={[
    { label: 'Все статьи', href: '/articles/' },
    { label: 'Контакты', href: '/#request' }
  ]}
  ctaText="Вызвать сервис"
  ctaHref="/#request"
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImagePath={article.data.cover}
>
  <main>
    <article class="intro">
      <div class="container intro-grid">
        <div>
          <div class="eyebrow">Материал</div>
          <h1 class="section-title">{article.data.title}</h1>
          {article.data.publishDate && (
            <p class="section-lead">{article.data.publishDate.toLocaleDateString('ru-RU')}</p>
          )}
        </div>
        <div>
          <p class="section-lead">{article.data.description}</p>
          {article.data.cover && (
            <img class="article-cover" src={withBase(article.data.cover)} alt="" loading="lazy" />
          )}
          <div class="article-body">
            <Content />
          </div>
        </div>
      </div>
    </article>
  </main>
  <MobileCta variant="service" requestHref={withBase('/#request')} secondaryHref={withBase('/articles/')} secondaryLabel="Статьи" enablePhoto={false} />
</BaseLayout>
